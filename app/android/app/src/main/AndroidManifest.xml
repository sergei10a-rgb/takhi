<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"/>

    <!-- The taximeter has to keep measuring while it is not the app on
         screen. Without a foreground service Android throttles location
         delivery the moment the app is backgrounded or the screen sleeps,
         and the fixes simply stop arriving.

         That is not a theoretical concern: a driver ran Тахь beside a
         commercial meter, switching between the two on one phone, and our
         odometer came back 26% and 13% short over two rides. A meter that
         under-measures does not fail loudly — it hands the driver a smaller
         number and says nothing.

         FOREGROUND_SERVICE_LOCATION is required from API 34 in addition to
         FOREGROUND_SERVICE; the service itself is declared by
         geolocator_android with foregroundServiceType="location".

         The persistent notification this creates is not a cost to be
         minimised. It is the only thing telling a driver their position is
         being read while they are looking at something else, and it must
         stay dismissable-proof for exactly as long as the meter runs and no
         longer. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION"/>

    <!-- Lets the location service hold a CPU wakelock while a run is on the
         clock, so a phone in a cradle with the screen off still delivers
         fixes as they happen instead of a burst when it next wakes. A burst
         is worse than late data here: the meter measures the straight line
         between consecutive fixes, so ten minutes collapsed into one jump
         bills a straight line across streets nobody drove. -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>

    <!-- The driver's portrait (profile/driver_profile_page.dart) is taken with
         the camera or picked from the gallery through `image_picker`.

         NOTE: android.permission.CAMERA is deliberately NOT declared, and
         adding it would BREAK the camera button rather than enable it.
         `image_picker` does not open the camera itself: it fires an
         ACTION_IMAGE_CAPTURE intent and lets the system camera app take the
         photo, which needs no permission from us. But Android's rule is that
         once an app *declares* CAMERA, that intent is refused with a
         SecurityException until the user has also granted it at runtime,
         so declaring it converts a working flow into one that throws on
         every device where the driver has not granted a permission the app
         never actually needs. The same holds for the gallery: from API 33
         the system photo picker returns a URI without READ_MEDIA_IMAGES, and
         below that `image_picker` uses ACTION_GET_CONTENT, which is likewise
         permission-free.

         What is declared is the hardware as OPTIONAL. Without this line the
         Play Store would be free to infer a camera requirement and hide the
         app from tablets and cheap handsets that have none — and a driver on
         such a device can still set a portrait from the gallery, so the app
         must stay installable for them.

         `_pickPhoto` still handles a denial (PlatformException
         `camera_access_denied` / `photo_access_denied`): an OEM build or a
         future policy change can refuse regardless, and the screen has to
         say so instead of the button doing nothing. -->
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <uses-feature android:name="android.hardware.camera.any" android:required="false"/>

    <application
        android:label="takhi"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
